<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ArtKnit — Дашборд руководителя</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { overflow-x: hidden; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: #F6F8F7;
    color: #1F2937;
    font-size: 14px;
    line-height: 1.45;
  }
  .app { display: flex; min-height: 100vh; }
  .sidebar {
    width: 240px; background: #FFFFFF;
    border-right: 1px solid #E5E7EB;
    padding: 20px 16px;
    display: flex; flex-direction: column; gap: 24px;
    position: sticky; top: 0; height: 100vh;
  }
  .logo { display: flex; align-items: center; gap: 10px; }
  .logo-icon {
    width: 40px; height: 40px; background: #13AB7B;
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 20px;
  }
  .logo-text h1 { font-size: 16px; font-weight: 700; }
  .logo-text p { font-size: 12px; color: #6B7280; }
  .section-title {
    font-size: 11px; font-weight: 600; color: #9CA3AF;
    text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;
  }
  .nav { display: flex; flex-direction: column; gap: 2px; }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 8px;
    color: #374151; font-size: 14px; cursor: pointer;
  }
  .nav-item:hover { background: #F3F4F6; }
  .nav-item.active { background: #E8F5EE; color: #13AB7B; font-weight: 600; }
  .nav-item .ico { width: 18px; text-align: center; }
  .main { flex: 1; padding: 20px 28px 40px; min-width: 0; }
  .topbar { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
  .page-title h1 { font-size: 20px; font-weight: 700; }
  .page-title p { font-size: 13px; color: #6B7280; margin-top: 2px; }
  .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .user {
    display: flex; align-items: center; gap: 8px;
    background: #FFFFFF; border: 1px solid #E5E7EB;
    border-radius: 20px; padding: 6px 14px 6px 6px;
    white-space: nowrap;
  }
  .avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: #13AB7B; color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-weight: 600; font-size: 13px;
  }
  .btn-primary {
    background: #13AB7B; color: #fff; border: none;
    border-radius: 20px; padding: 10px 20px;
    font-size: 14px; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; gap: 6px;
    white-space: nowrap;
  }
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px; margin-bottom: 20px;
  }
  .kpi {
    background: #FFFFFF; border: 1px solid #E5E7EB;
    border-radius: 16px; padding: 18px;
  }
  .kpi .label {
    font-size: 12px; color: #6B7280;
    display: flex; align-items: center; gap: 6px;
    margin-bottom: 8px;
  }
  .kpi .value {
    font-size: 26px; font-weight: 800;
    letter-spacing: -0.5px; color: #1F2937;
  }
  .kpi .value.green { color: #13AB7B; }
  .kpi .value.orange { color: #FE8B4B; }
  .kpi .delta { font-size: 12px; margin-top: 4px; color: #6B7280; }
  .kpi .delta.up { color: #13AB7B; font-weight: 600; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 20px; margin-bottom: 20px;
  }
  .card {
    background: #FFFFFF; border: 1px solid #E5E7EB;
    border-radius: 16px; padding: 20px;
  }
  .card-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 16px; gap: 10px; flex-wrap: wrap;
  }
  .card-head h3 {
    font-size: 15px; font-weight: 700;
    display: flex; align-items: center; gap: 8px;
  }
  .card-head .sub { font-size: 12px; color: #9CA3AF; }
  .funnel { display: flex; flex-direction: column; gap: 10px; }
  .funnel-row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 70px 60px;
    gap: 14px; align-items: center; font-size: 13px;
  }
  .funnel-row .name { color: #374151; font-weight: 500; }
  .funnel-row .bar-wrap {
    height: 32px; background: #F3F4F6;
    border-radius: 8px; overflow: hidden;
    position: relative;
  }
  .funnel-row .bar {
    height: 100%;
    background: linear-gradient(90deg, #13AB7B 0%, #4CC98A 100%);
    border-radius: 8px;
    display: flex; align-items: center;
    padding-left: 12px; color: #fff;
    font-weight: 700; font-size: 12.5px;
    white-space: nowrap; overflow: hidden;
  }
  .funnel-row .bar.orange {
    background: linear-gradient(90deg, #FE8B4B 0%, #FFB870 100%);
  }
  .funnel-row .pct { font-weight: 700; color: #13AB7B; text-align: right; }
  .funnel-row .pct.orange { color: #FE8B4B; }
  .funnel-row .delta { font-size: 12px; color: #9CA3AF; text-align: right; }
  .study-list { display: flex; flex-direction: column; gap: 12px; }
  .study-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    background: #FAFBFC; border-radius: 12px;
  }
  .study-row .icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: #E8F5EE; color: #13AB7B;
    display: grid; place-items: center; font-size: 16px;
  }
  .study-row .body { flex: 1; min-width: 0; }
  .study-row .body .t { font-size: 13px; font-weight: 700; }
  .study-row .body .s { font-size: 11.5px; color: #6B7280; margin-top: 2px; }
  .study-row .count {
    font-size: 18px; font-weight: 800;
    color: #13AB7B;
  }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead th {
    text-align: left; padding: 10px 12px;
    color: #6B7280; font-size: 11.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
    border-bottom: 1px solid #E5E7EB; white-space: nowrap;
  }
  tbody td {
    padding: 12px;
    border-bottom: 1px solid #F3F4F6;
    color: #1F2937;
  }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #FAFBFC; }
  .badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 10px; border-radius: 999px;
    font-size: 11px; font-weight: 700;
  }
  .badge.green { background: #E8F5EE; color: #13AB7B; }
  .badge.orange { background: #FFF4E6; color: #FE8B4B; }
  .badge.red { background: #FDECEA; color: #E53935; }
  @media (max-width: 1100px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="app">

  <aside class="sidebar">
    <div class="logo">
      <div class="logo-icon">♥</div>
      <div class="logo-text">
        <h1>ArtKnit</h1>
        <p>Кардиоцентр</p>
      </div>
    </div>
    <div>
      <div class="section-title">Рабочее пространство</div>
      <nav class="nav">
        <div class="nav-item"><span class="ico">🏠</span> Главная</div>
        <div class="nav-item"><span class="ico">👥</span> Пациенты</div>
        <div class="nav-item"><span class="ico">📋</span> Записи</div>
        <div class="nav-item active"><span class="ico">📊</span> Аналитика</div>
        <div class="nav-item"><span class="ico">📅</span> Календарь</div>
      </nav>
    </div>
    <div>
      <div class="section-title">Управление</div>
      <nav class="nav">
        <div class="nav-item"><span class="ico">🔔</span> Уведомления</div>
        <div class="nav-item"><span class="ico">✅</span> Задачи</div>
        <div class="nav-item"><span class="ico">💳</span> Финансы</div>
        <div class="nav-item"><span class="ico">👤</span> Персонал</div>
        <div class="nav-item"><span class="ico">⚙️</span> Настройки</div>
      </nav>
    </div>
  </aside>

  <main class="main">

    <div class="topbar">
      <div class="page-title">
        <h1>Дашборд руководителя</h1>
        <p>Воронка хирургической конверсии · обновлено {{ generated_at }}</p>
      </div>
      <div class="topbar-right">
        <div class="user">
          <div class="avatar">РК</div>
          <span>Руководитель К. ▾</span>
        </div>
        <button class="btn-primary">Экспорт</button>
      </div>
    </div>

    <!-- KPI -->
    <div class="kpi-grid">
      <div class="kpi">
        <div class="label">📊 Всего протоколов</div>
        <div class="value">{{ kpi.total }}</div>
        <div class="delta">за период</div>
      </div>
      <div class="kpi">
        <div class="label">🩺 Маршрут создан</div>
        <div class="value green">{{ kpi.assigned }}</div>
        <div class="delta up">{{ kpi.assigned_pct }} конверсия</div>
      </div>
      <div class="kpi">
        <div class="label">🚨 Срочных случаев</div>
        <div class="value orange">{{ kpi.urgent }}</div>
        <div class="delta">urgent / oncological</div>
      </div>
      <div class="kpi">
        <div class="label">👥 Мультидисциплинарных</div>
        <div class="value">{{ kpi.multidisciplinary }}</div>
        <div class="delta">консилиум</div>
      </div>
    </div>

    <!-- Funnel + by_organ -->
    <div class="grid">
      <div class="card">
        <div class="card-head">
          <h3>📈 Воронка конверсии</h3>
          <span class="sub">{{ kpi.total }} → {{ kpi.control }}</span>
        </div>
        <div class="funnel">
          {% for row in funnel %}
          <div class="funnel-row">
            <span class="name">{{ row.name }}</span>
            <div class="bar-wrap">
              <div class="bar {% if loop.index0 in [2, 3] %}orange{% endif %}" style="width: {{ row.bar_width }}%;">
                {{ row.count }}
              </div>
            </div>
            <span class="pct {% if loop.index0 in [2, 3] %}orange{% endif %}">{{ row.pct }}</span>
            <span class="delta">{{ row.delta }}</span>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h3>🔬 Типы исследований</h3>
          <span class="sub">с триггерами</span>
        </div>
        <div class="study-list">
          {% for organ in by_organ %}
          <div class="study-row">
            <div class="icon">{{ organ.icon }}</div>
            <div class="body">
              <div class="t">{{ organ.name }}</div>
              <div class="s">триггеров: {{ organ.count }}</div>
            </div>
            <div class="count">{{ organ.count }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Active routes -->
    <div class="card">
      <div class="card-head">
        <h3>📋 Активные маршруты</h3>
        <span class="sub">последние {{ active_routes | length }} из {{ kpi.assigned }}</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Пациент</th>
              <th>Находка</th>
              <th>Специалист</th>
              <th>Срочность</th>
            </tr>
          </thead>
          <tbody>
            {% for r in active_routes %}
            <tr>
              <td>{{ r.patient_name }}</td>
              <td>{{ r.finding }}</td>
              <td>{{ r.specialist }}</td>
              <td><span class="badge {{ r.badge_class }}">{{ r.badge }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

</body>
</html>
