<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Вход — ArtKnit | СМ-Клиника</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --primary: #2563EB;
    --primary-hover: #1D4ED8;
    --primary-light: #EFF6FF;
    --text: #111827;
    --text-muted: #6B7280;
    --border: #E5E7EB;
    --bg: #F9FAFB;
    --error-bg: #FEF2F2;
    --error-border: #FECACA;
    --error-text: #991B1B;
    --success-bg: #ECFDF5;
    --success-border: #A7F3D0;
    --success-text: #065F46;
    --radius: 12px;
    --radius-sm: 8px;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.06), 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif;
    background: linear-gradient(135deg, #EFF6FF 0%, #F9FAFB 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    color: var(--text);
    line-height: 1.5;
  }

  .login-wrap {
    width: 100%;
    max-width: 440px;
  }

  /* --- Логотип и заголовок --- */
  .brand {
    text-align: center;
    margin-bottom: 28px;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--primary);
    color: white;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 16px;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
  }

  .brand-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand-subtitle {
    font-size: 14px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  /* --- Карточка --- */
  .card {
    background: white;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 32px;
    border: 1px solid var(--border);
  }

  .card h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .card p.hint {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  /* --- Поля --- */
  .field {
    margin-bottom: 16px;
  }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 6px;
  }

  .field .input-wrap {
    position: relative;
  }

  .field input {
    width: 100%;
    padding: 11px 14px;
    font-size: 14px;
    font-family: inherit;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: white;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
  }

  .field input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .field input.error {
    border-color: var(--error-border);
  }

  /* Кнопка «глаз» */
  .toggle-eye {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    padding: 4px 8px;
    color: var(--text-muted);
    border-radius: 6px;
  }

  .toggle-eye:hover {
    background: var(--bg);
  }

  /* --- Роли (быстрый выбор для демо) --- */
  .roles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 20px;
  }

  .role-btn {
    padding: 10px 8px;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid var(--border);
    background: white;
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-align: center;
    color: var(--text-muted);
    transition: all 0.15s;
    font-family: inherit;
  }

  .role-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-light);
  }

  .role-btn.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .role-btn .icon {
    display: block;
    font-size: 18px;
    margin-bottom: 4px;
  }

  /* --- Кнопка «Войти» --- */
  .btn-primary {
    width: 100%;
    padding: 12px 16px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    color: white;
    background: var(--primary);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s, transform 0.05s;
    margin-top: 8px;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--primary-hover);
  }

  .btn-primary:active:not(:disabled) {
    transform: translateY(1px);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* --- Сообщения --- */
  .alert {
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    margin-bottom: 16px;
    display: none;
    border: 1px solid;
  }

  .alert.show { display: block; }

  .alert.error {
    background: var(--error-bg);
    border-color: var(--error-border);
    color: var(--error-text);
  }

  .alert.success {
    background: var(--success-bg);
    border-color: var(--success-border);
    color: var(--success-text);
  }

  /* --- Футер --- */
  .footer {
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 24px;
  }

  .footer a {
    color: var(--primary);
    text-decoration: none;
  }

  .footer a:hover { text-decoration: underline; }

  /* --- Демо-подсказка --- */
  .demo-hint {
    margin-top: 20px;
    padding: 12px 14px;
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: var(--radius-sm);
    font-size: 12px;
    color: #78350F;
    line-height: 1.6;
  }

  .demo-hint strong { color: #451A03; }

  .demo-hint code {
    background: rgba(0, 0, 0, 0.06);
    padding: 1px 6px;
    border-radius: 4px;
    font-family: "SF Mono", Monaco, Consolas, monospace;
    font-size: 11px;
  }

  /* --- Спиннер --- */
  .spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    vertical-align: -2px;
    margin-right: 6px;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 480px) {
    .card { padding: 24px 20px; }
    .roles { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="login-wrap">

  <!-- Логотип -->
  <div class="brand">
    <div class="brand-logo">A</div>
    <div class="brand-title">ArtKnit</div>
    <div class="brand-subtitle">Система маршрутизации пациентов · СМ-Клиника</div>
  </div>

  <!-- Карточка входа -->
  <div class="card">
    <h2>Вход в систему</h2>
    <p class="hint">Введите API-ключ или выберите роль для демо-режима</p>

    <!-- Сообщения -->
    <div id="alert" class="alert"></div>

    <!-- Быстрый выбор роли (только для демо) -->
    <div class="roles" role="tablist">
      <button type="button" class="role-btn" data-role="doctor"
              onclick="pickRole('doctor')">
        <span class="icon">👨‍⚕️</span>Врач
      </button>
      <button type="button" class="role-btn" data-role="manager"
              onclick="pickRole('manager')">
        <span class="icon">📊</span>Руководитель
      </button>
      <button type="button" class="role-btn" data-role="admin"
              onclick="pickRole('admin')">
        <span class="icon">🔑</span>Админ
      </button>
    </div>

    <!-- Форма -->
    <form id="loginForm" onsubmit="return handleLogin(event)" autocomplete="off">
      <div class="field">
        <label for="apiKey">API-ключ</label>
        <div class="input-wrap">
          <input type="password" id="apiKey" name="api_key"
                 placeholder="doctor_key_abc123"
                 autocomplete="current-password" required>
          <button type="button" class="toggle-eye"
                  onclick="togglePassword()"
                  aria-label="Показать/скрыть">👁</button>
        </div>
      </div>

      <button type="submit" class="btn-primary" id="submitBtn">
        Войти
      </button>
    </form>

    <!-- Демо-подсказка -->
    <div class="demo-hint">
      <strong>Демо-ключи</strong> (см. <code>config/roles.yaml</code>):<br>
      👨‍⚕️ Врач: <code>doctor_key_abc123</code><br>
      📊 Руководитель: <code>manager_key_xyz789</code><br>
      🔑 Админ: <code>admin_key_root</code>
    </div>
  </div>

  <div class="footer">
    © 2026 СМ-Клиника · <a href="/help">Помощь</a> ·
    <a href="/privacy">Политика конфиденциальности</a>
  </div>

</div>

<script>
  // ========================================================================
  //  Конфигурация
  // ========================================================================
  const API_BASE = "";  // тот же origin (FastAPI на том же порту)
  const ROLE_REDIRECTS = {
    doctor:  "/doctor/dashboard",
    manager: "/manager",
    admin:   "/admin",
  };

  // ========================================================================
  //  Выбор роли (автозаполнение ключа для демо)
  // ========================================================================
  const DEMO_KEYS = {
    doctor:  "doctor_key_abc123",
    manager: "manager_key_xyz789",
    admin:   "admin_key_root",
  };

  function pickRole(role) {
    // Подсветка активной кнопки
    document.querySelectorAll(".role-btn").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.role === role);
    });
    // Автозаполнение ключа
    const input = document.getElementById("apiKey");
    input.value = DEMO_KEYS[role] || "";
    input.focus();
    hideAlert();
  }

  // ========================================================================
  //  Показать/скрыть пароль
  // ========================================================================
  function togglePassword() {
    const input = document.getElementById("apiKey");
    input.type = input.type === "password" ? "text" : "password";
  }

  // ========================================================================
  //  Сообщения
  // ========================================================================
  function showAlert(message, type = "error") {
    const el = document.getElementById("alert");
    el.className = `alert show ${type}`;
    el.textContent = message;
  }

  function hideAlert() {
    const el = document.getElementById("alert");
    el.className = "alert";
    el.textContent = "";
  }

  // ========================================================================
  //  Логин
  // ========================================================================
  async function handleLogin(event) {
    event.preventDefault();
    hideAlert();

    const apiKey = document.getElementById("apiKey").value.trim();
    if (!apiKey) {
      showAlert("Введите API-ключ");
      return false;
    }

    const btn = document.getElementById("submitBtn");
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Проверяем…';

    try {
      const resp = await fetch(`${API_BASE}/api/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ api_key: apiKey }),
      });

      const data = await resp.json();

      if (!resp.ok) {
        throw new Error(data.detail || "Не удалось войти");
      }

      // Успех — сохраняем токен и роль
      const token = data.access_token;
      const role  = data.role;

      // JWT в localStorage (для SPA-стиля) — либо в httpOnly cookie
      // с сервера (безопаснее, если backend так умеет).
      localStorage.setItem("artknit_token", token);
      localStorage.setItem("artknit_role", role);
      localStorage.setItem("artknit_name", data.name || "");

      showAlert(
        `Добро пожаловать, ${data.name || role}! Перенаправляем…`,
        "success"
      );

      // Редирект по роли
      const target = ROLE_REDIRECTS[role] || "/";
      setTimeout(() => { window.location.href = target; }, 500);

      return false;
    } catch (err) {
      showAlert(err.message || "Ошибка сети");
      btn.disabled = false;
      btn.textContent = originalText;
      return false;
    }
  }

  // ========================================================================
  //  Автоподстановка ключа из URL: /login?key=doctor_key_abc123
  //  (удобно для быстрого перехода в демо)
  // ========================================================================
  window.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);
    const key = params.get("key");
    if (key) {
      document.getElementById("apiKey").value = key;
    }

    // Если уже залогинен — сразу редирект
    const existingToken = localStorage.getItem("artknit_token");
    const existingRole  = localStorage.getItem("artknit_role");
    if (existingToken && existingRole && ROLE_REDIRECTS[existingRole]) {
      // Проверим токен на сервере (опционально)
      fetch(`${API_BASE}/api/me`, {
        headers: { "Authorization": `Bearer ${existingToken}` }
      }).then(r => {
        if (r.ok) window.location.href = ROLE_REDIRECTS[existingRole];
        else {
          localStorage.removeItem("artknit_token");
          localStorage.removeItem("artknit_role");
        }
      }).catch(() => { /* тихо игнорируем — покажем форму */ });
    }
  });
</script>

</body>
</html>
